# Copy this file to .env and replace every placeholder before starting the API.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
OWNER_ACCESS_KEY=replace-with-a-random-secret-of-at-least-32-characters
OWNER_PIN_HASH=generate-with-npm-run-security-hash-pin
AUTH_SIGNING_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_MAX=60
LOG_LEVEL=info
