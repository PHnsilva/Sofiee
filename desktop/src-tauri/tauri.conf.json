{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sofiie",
  "version": "0.1.0",
  "identifier": "com.sofiie.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://localhost:3000 http://127.0.0.1:3000 https:; img-src 'self' asset: http://asset.localhost; style-src 'self'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Sofiie",
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
